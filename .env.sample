BOT_TOKEN=
VRC_USERNAME=
VRC_PASSWORD=
VRC_TOTP_KEY=
ADMIN_ID=
EXPORT_RATE_LIMIT=1500
DEV=false
WORLD_NAME_MATCHERS=World:,World :,📸✨🌏World:,World name:,World,ワールド名
AUTHOR_NAME_MATCHERS=Author:,Author :,👤Author:,By:,Author,by
FORWARD_PLAYER_COUNT_THRESHOLD=40
LOW_CAPACITY_THRESHOLD=20

# API server config
API_PORT=3000
# API_HOST controls which interface the Fastify API binds to.
# Use 127.0.0.1 when running behind a reverse proxy like Caddy or Nginx.
API_HOST=0.0.0.0
# API_TOKEN is a Bearer token for /api/* endpoints (supports multiple tokens
# separated by commas). Falls back to EXPORT_API_TOKEN if not set.
API_TOKEN=
# Comma-separated list of allowed Origin values for CORS and origin validation.
# Example: API_ALLOWED_ORIGINS=https://sosd.googoogaagaa.club,https://testnet.googoogaagaa.club
# Leave empty to allow any origin (current default behavior).
API_ALLOWED_ORIGINS=
# Comma-separated list of allowed source IP addresses for /api/* endpoints.
# Useful for locking down admin or scripted access. Example:
# API_ALLOWED_IPS=203.0.113.42,127.0.0.1
# Leave empty to skip IP allowlisting. When set, the API trusts loopback proxies
# (e.g. Caddy/Nginx on the same host) to provide the real client IP.
API_ALLOWED_IPS=

# SQLite database path for world metadata storage
DATABASE_PATH=./worlds.db
