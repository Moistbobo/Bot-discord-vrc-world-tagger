BOT_TOKEN=
ADMIN_ID=
EXPORT_RATE_LIMIT=1500
DEV=false
FORWARD_PLAYER_COUNT_THRESHOLD=40
LOW_CAPACITY_THRESHOLD=20

# API client config (points at the standalone sos-world-tagger-api service)
# Base URL of the API. Use 127.0.0.1 when both run on the same host; the port
# must match the API service's API_PORT (default 3000).
API_BASE_URL=http://127.0.0.1:3000
# Bearer token the bot sends to the API for /api/* endpoints. Must match a
# token provisioned in the API service (see its repo for `pnpm token:create`).
API_TOKEN=
