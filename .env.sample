BOT_TOKEN=
VRC_USERNAME=
VRC_PASSWORD=
VRC_TOTP_KEY=
ADMIN_ID=
EXPORT_RATE_LIMIT=1500
DEV=false
WORLD_NAME_MATCHERS=World:,World :,📸✨🌏World:,World name:,World,ワールド名
AUTHOR_NAME_MATCHERS=Author:,Author :,👤Author:,By:,Author,by
FORWARD_PLAYER_COUNT_THRESHOLD=40
LOW_CAPACITY_THRESHOLD=20

# API client config (points at the standalone sos-world-tagger-api service)
# Base URL of the standalone API. Use 127.0.0.1 when both run on the same host.
API_BASE_URL=http://127.0.0.1:3000
# API_TOKEN is the Bearer token the bot sends to the API for /api/* endpoints.
# Must match a token configured in the API's API_TOKEN. Falls back to EXPORT_API_TOKEN.
API_TOKEN=
EXPORT_API_TOKEN=
